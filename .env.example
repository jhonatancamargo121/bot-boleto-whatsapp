# ===== Aplicacao =====
APP_PORT=3000

# ===== Evolution API =====
# Em deploy na mesma rede docker use o nome do container:
EVOLUTION_API_URL=http://assistente-evolution:8080
EVOLUTION_API_KEY=COLOQUE_A_APIKEY_GLOBAL_AQUI
EVOLUTION_INSTANCE=agente01

# ===== Seguranca do webhook =====
WEBHOOK_TOKEN=troque_este_token

# ===== Banco de dados (PostgreSQL) =====
# Senha usada pelo container agente01-postgres (docker-compose lê PGPASSWORD).
PGPASSWORD=troque_esta_senha
DATABASE_URL=postgresql://agente01:troque_esta_senha@agente01-postgres:5432/agente01

# ===== IA (DeepSeek) - restrita a segunda via/boleto =====
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== Painel de monitoramento =====
PAINEL_USUARIO=admin
PAINEL_SENHA=troque_esta_senha
PAINEL_SECRET=troque_por_um_valor_aleatorio_longo
COOKIE_SECURE=true

# ===== Comportamento do bot =====
USE_BUTTONS=false
SEND_PDF=true
EMPRESA_NOME=Natela Imoveis
